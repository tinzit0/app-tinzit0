{
  "expo": {
    "name": "Tinzit0",
    "slug": "tinzit0",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundImage": "./assets/android-icon-background.png",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png",
        "backgroundColor": "#0B0B0C"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.tinzit0.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-sqlite",
      "expo-font",
      "@react-native-community/datetimepicker",
      "expo-sharing",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Tinzit0 usa el micrófono para escuchar lo que le pides al asistente.",
          "speechRecognitionPermission": "Tinzit0 convierte tu voz en texto para entender tus comandos.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox",
            "com.google.android.as"
          ]
        }
      ],
      "expo-secure-store",
      "./plugins/withAppQueries",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 132,
          "resizeMode": "contain",
          "backgroundColor": "#0B0B0C",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#0B0B0C"
          }
        }
      ],
      [
        "react-native-android-widget",
        {
          "fonts": [
            "./assets/fonts/Inter_700Bold.ttf",
            "./assets/fonts/Inter_500Medium.ttf"
          ],
          "widgets": [
            {
              "name": "Resumen",
              "label": "Tinzit0 · Hoy",
              "description": "Tus tareas de hoy y el gasto de la semana",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000,
              "previewImage": "./assets/widget-preview.png"
            }
          ]
        }
      ]
    ],
    "scheme": "tinzit0",
    "backgroundColor": "#0B0B0C"
  }
}
