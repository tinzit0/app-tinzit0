{
  "expo": {
    "name": "Tinzit0",
    "slug": "tinzit0",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "Tinzit0 convierte tu voz en texto para entender tus comandos.",
        "NSMicrophoneUsageDescription": "Tinzit0 usa el micrófono para escuchar lo que le pides al asistente."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundImage": "./assets/android-icon-background.png",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png",
        "backgroundColor": "#D6F87A"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.tinzit0.app",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-sqlite",
      "expo-font",
      "@react-native-community/datetimepicker",
      "expo-sharing",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Tinzit0 usa el micrófono para escuchar lo que le pides al asistente.",
          "speechRecognitionPermission": "Tinzit0 convierte tu voz en texto para entender tus comandos.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox",
            "com.google.android.as"
          ]
        }
      ],
      "expo-secure-store",
      "./plugins/withAppQueries",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 132,
          "resizeMode": "contain",
          "backgroundColor": "#CFF56B",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#CFF56B"
          }
        }
      ],
      [
        "react-native-android-widget",
        {
          "fonts": [
            "./assets/fonts/Inter_700Bold.ttf",
            "./assets/fonts/Inter_500Medium.ttf"
          ],
          "widgets": [
            {
              "name": "Resumen",
              "label": "Tinzit0 · Hoy",
              "description": "Tus tareas de hoy y el gasto de la semana",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000,
              "previewImage": "./assets/widget-preview.png"
            }
          ]
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Tinzit0 usa tu ubicación aproximada solo para mostrarte el clima de tu ciudad."
        }
      ]
    ],
    "scheme": "tinzit0",
    "backgroundColor": "#0B0B0C",
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "44374539-1e9a-4fb7-b0d2-8a7ac00e837c"
      }
    },
    "owner": "tinzit0"
  }
}
